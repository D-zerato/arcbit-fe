{
  "name": "arcbit-fe-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter arcbit-fe dev",
    "storybook": "pnpm --filter storybook-app storybook",
    "storybook:build": "pnpm --filter storybook-app build-storybook",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test && vitest run --pool forks --config vitest.root.config.ts",
    "test:stories": "pnpm --filter storybook-app test-stories",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "tokens": "pnpm --filter @arcbit/tokens tokens",
    "tokens:check": "pnpm --filter @arcbit/tokens tokens:check",
    "capabilities": "node scripts/build-capabilities.mjs",
    "capabilities:check": "node scripts/build-capabilities.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@arcbit/theme": "workspace:*",
    "@arcbit/tokens": "workspace:*",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/react-query": "^5.99.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
